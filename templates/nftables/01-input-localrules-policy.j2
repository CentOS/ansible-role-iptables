# Local rules defined through ansible iptables_local_input_rules
{% for rule in iptables_local_input_rules %}

{% if rule.dport is defined -%}
{% set iptables_dport = 'dport ' + rule.dport|string %}
{% else %}
{% set iptables_dport = '' %}
{% endif -%}

{# Note that the conditional is flipped from how we handle the dport, this is
 because previously we set a default to tcp if the protocol was undefined. If
 we want to set ip-based INPUT rules (for all protocols), we need to
 explicitly set rule.protocol to None
#}
{% if rule.protocol is not defined -%}
{% set iptables_protocol = 'tcp' %}
{% elif rule.protocol == '' %}
{% set iptables_protocol = '' %}
{% else %}
{% set iptables_protocol = rule.protocol %}
{% endif %}

{% if rule.source is not defined -%}
{% set iptables_source = 'ip saddr ' + '0.0.0.0/0' %}
{% elif rule.source == '' %}
{% set iptables_source = '' %}
{% else %}
{% set iptables_source = 'ip saddr ' + rule.source|string %}
{% endif %}

{# This is a 'new' conditional, so we can use the same pattern as above #}
{% if rule.destination is defined -%}
{% set iptables_destination = 'ip daddr ' + rule.destination|string %}
{% else %}
{% set iptables_destination = '' %}
{% endif %}

add rule inet filter INPUT {{ iptables_source }} {{ iptables_destination }} {{ iptables_protocol }} {{ iptables_dport }}  counter accept

{% endfor %}
