# {{ iptables_policy_name }} ipv4 nft rule
# Parsing list 'iptables_allowed_from'
{% for ip_src_addr in iptables_allowed_from %}
add rule inet filter INPUT ct state new ip saddr {{ ip_src_addr|default('0.0.0.0/0') }} {{ iptables_protocol|default('tcp') }} dport {{ iptables_port }} counter accept
{% endfor %}
